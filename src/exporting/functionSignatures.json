{
  "_schemaVersion": "1.0.0",

  "st_export_test_bundle":
  {
    "inputs":
    [
      {"name":"Destination", "kind":"namevalue", "type":["folder"], "purpose":"번들을 만들 상위 폴더"},
      {"name":"RunId", "kind":"namevalue", "type":["char"], "purpose":"참조 보고서로 쓸 run 폴더 이름 또는 LATEST"},
      {"name":"CreateArchive", "kind":"namevalue", "type":["logical","scalar"], "purpose":"번들 폴더 옆에 ZIP 생성"},
      {"name":"IncludeReferenceReport", "kind":"namevalue", "type":["logical","scalar"], "purpose":"기준 통합 보고서 포함"},
      {"name":"Profile", "kind":"namevalue", "type":["choices={'REPRODUCIBLE','ASSET'}"], "purpose":"재현 번들 또는 자산 번들"},
      {"name":"ExecutionModelMode", "kind":"namevalue", "type":["choices={'ORIGINAL','STANDALONE_HARNESS'}"], "purpose":"내부 Harness 사용 또는 독립 모델로 내보내기"},
      {"name":"AnalyzeProducts", "kind":"namevalue", "type":["logical","scalar"], "purpose":"필요 툴박스 분석. 느리며 manifest 안내용"}
    ]
  },

  "st_export_test_specification":
  {
    "inputs":
    [
      {"name":"OutputFile", "kind":"namevalue", "type":["file=*.xlsx"], "purpose":"저장할 파일 경로. 이미 있으면 실패"},
      {"name":"VerifyMode", "kind":"namevalue", "type":["choices={'STEP2','ALL_STEPS_COLUMNS'}"], "purpose":"verify를 한 열에 모을지 스텝별로 나눌지"},
      {"name":"DecisionBlockScope", "kind":"namevalue", "type":["choices={'EXPLICIT','ALL','NONE'}"], "purpose":"DecisionBlocks에 담을 블록 범위"}
    ]
  },

  "st_export_final_document":
  {
    "inputs":
    [
      {"name":"OutputFile", "kind":"namevalue", "type":["file=*.xlsx"], "purpose":"저장할 파일 경로. 이미 있으면 실패"},
      {"name":"DecisionBlockScope", "kind":"namevalue", "type":["choices={'EXPLICIT','ALL','NONE'}"], "purpose":"Description에 담을 분기 블록 범위"},
      {"name":"CoverageSource", "kind":"namevalue", "type":["choices={'STANDALONE','TEST_RUN','NONE'}"], "purpose":"커버리지를 어디서 읽을지"},
      {"name":"CoveragePipelineId", "kind":"namevalue", "type":["char"], "purpose":"standalone pipeline 실행 id 또는 LATEST"},
      {"name":"ResultRun", "kind":"namevalue", "type":["char"], "purpose":"판정을 읽을 실행. AUTO, BATCH, PER_CUT 또는 실행 디렉터리"},
      {"name":"RequireTestResults", "kind":"namevalue", "type":["logical","scalar"], "purpose":"판정이 비면 경고 대신 중단"},
      {"name":"RequireCoverage", "kind":"namevalue", "type":["logical","scalar"], "purpose":"커버리지가 비면 경고 대신 중단"},
      {"name":"IncludeUsageSheet", "kind":"namevalue", "type":["logical","scalar"], "purpose":"내부 명령 목록 사용법 시트를 덧붙임"}
    ]
  }
}
